#include <stdio.h>
#include <stdlib.h>
#include <string.h>

/* ── Constantes del sistema simulado ───────────────────── */
#define PAGE_SIZE       4096
#define NUM_PAGES       16
#define NUM_FRAMES      8
#define ADDR_BITS       16
#define PAGE_BITS       4
#define OFFSET_BITS     12

/* ── Estructura de entrada en la tabla de páginas ──────── */
typedef struct {
    int frame_number;
    int present;
    int dirty;
    int referenced;
    int read_only;
} PageTableEntry;

/* ── Tabla de páginas ──────────────────────────────────── */
PageTableEntry page_table[NUM_PAGES];

/* ── Mapa de marcos físicos ────────────────────────────── */
int frame_map[NUM_FRAMES];

/* ── Estadísticas de acceso ────────────────────────────── */
int total_accesses = 0;
int page_faults = 0;
int tlb_hits = 0;

/* ── Prototipos ────────────────────────────────────────── */
void init_page_table(void);
int find_free_frame(void);
void handle_page_fault(int page_num);
long translate_address(long logical_addr, int write_access);
void print_page_table(void);
void print_stats(void);


/* ════════════════════════════════════════════════════════
 * FUNCIÓN: init_page_table
 * ════════════════════════════════════════════════════════ */
void init_page_table(void) {
    int i;

    for (i = 0; i < NUM_PAGES; i++) {
        page_table[i].frame_number = -1;
        page_table[i].present = 0;
        page_table[i].dirty = 0;
        page_table[i].referenced = 0;
        page_table[i].read_only = 0;
    }

    memset(frame_map, 0, sizeof(frame_map));
}


/* ════════════════════════════════════════════════════════
 * FUNCIÓN: find_free_frame
 * ════════════════════════════════════════════════════════ */
int find_free_frame(void) {
    int i;

    for (i = 0; i < NUM_FRAMES; i++) {
        if (frame_map[i] == 0) {
            return i;
        }
    }

    return -1;
}


/* ════════════════════════════════════════════════════════
 * FUNCIÓN: handle_page_fault
 * Manejador simplificado de page fault.
 * ════════════════════════════════════════════════════════ */
void handle_page_fault(int page_num) {
    int frame;
    int victim;
    int i;

    page_faults++;

    printf("[PAGE FAULT] Pagina %d no esta en RAM.\n", page_num);

    frame = find_free_frame();

    /*
     * Si no hay marcos libres, realizar reemplazo.
     */
    if (frame == -1) {

        victim = -1;

        /*
         * Buscar una pagina presente que no haya sido
         * referenciada recientemente.
         */
        for (i = 0; i < NUM_PAGES; i++) {
            if (page_table[i].present &&
                page_table[i].referenced == 0) {

                victim = i;
                break;
            }
        }

        /*
         * Si todas las paginas tienen referenced = 1,
         * se limpian los bits y se vuelve a buscar.
         */
        if (victim == -1) {

            for (i = 0; i < NUM_PAGES; i++) {
                if (page_table[i].present) {
                    page_table[i].referenced = 0;
                }
            }

            for (i = 0; i < NUM_PAGES; i++) {
                if (page_table[i].present &&
                    page_table[i].referenced == 0) {

                    victim = i;
                    break;
                }
            }
        }

        /*
         * Verificar que se encontro una victima.
         */
        if (victim == -1) {
            printf("[ERROR] No se encontro pagina victima.\n");
            exit(1);
        }

        frame = page_table[victim].frame_number;

        /*
         * Si la pagina fue modificada, simular swap-out.
         */
        if (page_table[victim].dirty) {
            printf("[SWAP-OUT] Pagina %d -> disco\n", victim);
        }

        printf("[REEMPLAZO] Pagina %d sale del marco %d.\n",
               victim, frame);

        /*
         * Liberar la entrada de la pagina victima.
         */
        page_table[victim].frame_number = -1;
        page_table[victim].present = 0;
        page_table[victim].dirty = 0;
        page_table[victim].referenced = 0;

        printf("[REEMPLAZO] Marco %d asignado a pagina %d.\n",
               frame, page_num);
    }

    /*
     * Cargar la nueva pagina en el marco.
     */
    frame_map[frame] = 1;

    page_table[page_num].frame_number = frame;
    page_table[page_num].present = 1;
    page_table[page_num].referenced = 1;
    page_table[page_num].dirty = 0;

    printf("[PAGE-IN] Pagina %d cargada en marco fisico %d.\n",
           page_num, frame);
}


/* ════════════════════════════════════════════════════════
 * FUNCIÓN: translate_address
 * Traduce una dirección lógica a dirección física.
 * ════════════════════════════════════════════════════════ */
long translate_address(long logical_addr, int write_access) {
    int page_num;
    int offset;
    long physical_addr;

    total_accesses++;

    /*
     * Extraer numero de pagina y desplazamiento.
     *
     * Los 4 bits superiores representan la pagina.
     * Los 12 bits inferiores representan el offset.
     */
    page_num = (int)(logical_addr >> OFFSET_BITS);
    offset = (int)(logical_addr & (PAGE_SIZE - 1));

    printf("\n[TRADUCCION] Dir. logica: 0x%04lX  ->  Pag: %d, Offset: 0x%03X\n",
           logical_addr, page_num, offset);

    /*
     * Verificar rango de pagina.
     */
    if (page_num < 0 || page_num >= NUM_PAGES) {
        printf("[ERROR] Numero de pagina %d fuera de rango.\n",
               page_num);
        return -1;
    }

    /*
     * Verificar proteccion ANTES de comprobar presencia.
     */
    if (write_access && page_table[page_num].read_only) {
        printf("[PROTECCION] Escritura denegada en pagina %d (solo lectura).\n",
               page_num);
        return -1;
    }

    /*
     * Verificar presencia.
     */
    if (!page_table[page_num].present) {
        handle_page_fault(page_num);
    }
    else {
        /*
         * La pagina ya esta en RAM:
         * simular TLB hit.
         */
        tlb_hits++;

        printf("[TLB HIT] Pagina %d -> Marco %d\n",
               page_num,
               page_table[page_num].frame_number);
    }

    /*
     * Calcular direccion fisica.
     */
    physical_addr =
        ((long)page_table[page_num].frame_number * PAGE_SIZE)
        + offset;

    /*
     * Marcar pagina como modificada si fue una escritura.
     */
    if (write_access) {
        page_table[page_num].dirty = 1;
    }

    /*
     * Marcar pagina como referenciada.
     */
    page_table[page_num].referenced = 1;

    printf("[RESULTADO] Dir. fisica: 0x%05lX\n",
           physical_addr);

    return physical_addr;
}


/* ════════════════════════════════════════════════════════
 * FUNCIÓN: print_page_table
 * ════════════════════════════════════════════════════════ */
void print_page_table(void) {
    int i;

    printf("\n+===============================================+\n");
    printf("|          TABLA DE PAGINAS (proceso P1)       |\n");
    printf("+========+========+=========+=======+===========+\n");
    printf("|  Pag.  | Marco  |Presente | Dirty | Ref.      |\n");
    printf("+========+========+=========+=======+===========+\n");

    for (i = 0; i < NUM_PAGES; i++) {

        if (page_table[i].present ||
            page_table[i].frame_number != -1) {

            printf("|  %3d   |  %3d   |   %s     |   %s   |   %s       |\n",
                   i,
                   page_table[i].frame_number,
                   page_table[i].present ? "SI" : "NO",
                   page_table[i].dirty ? "SI" : "NO",
                   page_table[i].referenced ? "SI" : "NO");
        }
    }

    printf("+========+========+=========+=======+===========+\n");
}


/* ════════════════════════════════════════════════════════
 * FUNCIÓN: print_stats
 * ════════════════════════════════════════════════════════ */
void print_stats(void) {

    printf("\n========== ESTADISTICAS ==========\n");

    printf("Accesos totales : %d\n",
           total_accesses);

    printf("Page faults     : %d (%.1f%%)\n",
           page_faults,
           total_accesses ?
           100.0 * page_faults / total_accesses : 0.0);

    printf("TLB hits        : %d (%.1f%%)\n",
           tlb_hits,
           total_accesses ?
           100.0 * tlb_hits / total_accesses : 0.0);
}


/* ════════════════════════════════════════════════════════
 * MAIN — Casos de prueba
 * ════════════════════════════════════════════════════════ */
int main(void) {

    printf("===============================================\n");
    printf("  Laboratorio: Paginacion - Sistemas Operativos\n");
    printf("===============================================\n");

    init_page_table();

    /*
     * Marcar pagina 1 como solo lectura.
     */
    page_table[1].read_only = 1;

    /*
     * ── Casos originales ─────────────────────────────
     */

    /* Lectura: pagina 3, offset 0xA4F */
    translate_address(0x3A4F, 0);

    /* Escritura: pagina 3, ya esta en RAM */
    translate_address(0x3100, 1);

    /* Lectura: pagina 2, genera page fault */
    translate_address(0x2050, 0);

    /* Escritura en pagina 1: debe ser rechazada */
    translate_address(0x1000, 1);


    /*
     * ── Parte 3: accesos adicionales ────────────────
     */

    /* Pagina 5: lectura -> page fault */
    translate_address(0x5ABC, 0);

    /* Pagina 5: escritura -> TLB hit + dirty */
    translate_address(0x5DEF, 1);

    /* Pagina 4: lectura -> page fault */
    translate_address(0x4AAA, 0);

    /* Pagina 6: lectura -> page fault */
    translate_address(0x6123, 0);

    /* Pagina 7: escritura -> page fault + dirty */
    translate_address(0x7BCD, 1);

    /* Pagina 8: lectura -> page fault */
    translate_address(0x8AAA, 0);

    /* Pagina 9: lectura -> page fault y reemplazo */
    translate_address(0x9ABC, 0);

    /*
     * Volver a acceder a pagina 5 para observar
     * el comportamiento de TLB o page fault dependiendo
     * de si fue reemplazada.
     */
    translate_address(0x5ABC, 0);


    /*
     * Mostrar resultados finales.
     */
    print_page_table();
    print_stats();

    return 0;
}
